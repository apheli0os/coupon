# 本地开发/部署环境变量模板
# 使用方式：复制为 .env（已加入 .gitignore，不会被提交），按需修改密码与密钥

# MySQL（本地 demo 默认值，生产环境请务必替换为强密码）
DB_USER=root
DB_PASSWORD=root123456
MYSQL_ROOT_PASSWORD=root123456

# Redis（单机 demo 默认无密码；HA / Cluster 默认 mallRedis2026，生产请替换）
REDIS_PASSWORD=mallRedis2026

# JWT 签名密钥（长度至少 32 字节，生产环境务必替换为随机强密钥）
JWT_SECRET=mall-coupon-platform-default-secret-key-2026
